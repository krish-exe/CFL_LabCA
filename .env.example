# `npm run setup` copies this to .env and fills in the secrets. Don't edit this file for local use.
NODE_ENV=development

# Database. Leave as is to use the embedded PostgreSQL that setup creates (DB_MODE=embedded).
# To use your own server instead, run `npm run db:create` (see README) before setup.
DB_MODE=
DATABASE_URL=postgres://secureclinic:CHANGE_ME@127.0.0.1:5432/secureclinic

# HTTPS server (TLS). HTTP_PORT only redirects to HTTPS.
HTTPS_PORT=8443
HTTP_PORT=8080
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem

# Secrets - each must be long random hex. Never commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes (64 hex chars) master key for AES-256-GCM field and file encryption
DATA_ENCRYPTION_KEY=
# Key for the HMAC hash chain that makes the audit log tamper-evident
AUDIT_HMAC_KEY=

# Roles that must use TOTP two-factor authentication
MFA_REQUIRED_ROLES=admin,doctor

# Where encrypted uploads are stored
UPLOAD_DIR=storage/uploads

# Clinic timezone offset used for appointment slots
CLINIC_TZ_OFFSET=+05:30
